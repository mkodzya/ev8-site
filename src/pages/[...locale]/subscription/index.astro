---
// The subscription builder and the earnings calculator. Every option is plain
// HTML (radios, checkboxes, a range), rendered with the default choice already
// counted, so the page reads without JavaScript; the script (src/scripts/
// subscription.client.ts, inlined at the end) recounts on change.
// Phone: one column and a bar with the weekly price at the bottom.
// Laptop: options on the left, the summary and the calculator stay on the right.
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import { dict, localePaths, asset, type Locale } from '../../../i18n';
import { models, contact } from '../../../data/models';
import { gear, services, calc, petrolPrice, DEPOSIT } from '../../../data/subscription';
import { compute, gel } from '../../../lib/calc';
import { buildSync } from 'esbuild';

export const getStaticPaths = localePaths;
const { locale } = Astro.props as { locale: Locale };
const d = dict(locale);
const t = d.sub;
const fill = (s: string, n: number | string) => s.replace('{n}', String(n));
// The petrol price is read when the site is built (scripts/fuel-price.mjs), so
// the note under the comparison says the price and the day it is of.
const petrolShown = (petrolPrice.tetri / 100).toFixed(2).replace('.', locale === 'en' ? '.' : ',');
const petrolDate = petrolPrice.asOf.split('-').reverse().join('.');
const vsNote = t.vsNote.replace('{petrol}', petrolShown).replace('{petrolDate}', petrolDate);

const initial = compute({ modelId: models[0].id, gear: [], services: [], hours: calc.hoursDefault });
const gearText = t.gear as Record<string, string[]>;
const serviceText = t.services as Record<string, string[]>;

// The page's script is bundled here and inlined below as a plain script, so it
// runs while the page is being parsed — before the first paint. Why: see the
// head of src/scripts/subscription.client.ts.
const client = buildSync({
  entryPoints: ['src/scripts/subscription.client.ts'], bundle: true, minify: true, format: 'iife', target: 'es2019', write: false,
}).outputFiles[0].text;
---
<Base locale={locale} title={t.metaTitle} description={t.metaDesc} path="subscription/">
  <section class="dark sub-head">
    <div class="wrap">
      <h1>{t.title1} <em>{t.title2}</em></h1>
    </div>
  </section>

  <form class="wrap sub init" data-sub data-lang={locale} data-wa={contact.whatsapp} data-hello={t.msgHello} data-l-weekly={t.msgWeekly} data-l-today={t.msgToday} data-l-hours={t.msgHours}>
    <div class="sub-opts">
      <fieldset>
        <legend>{t.moped}</legend>
        <div class="mopeds">
          {models.map((m, i) => (
            <label class="moped">
              <input type="radio" name="model" value={m.id} checked={i === 0} data-label={m.name} />
              <span class="moped-img" style={`background-image:url(${asset(m.thumb)})`}></span>
              <b>{m.name}</b>
              <small>{m.weeklyGel} {d.garage.perWeekShort}</small>
            </label>
          ))}
        </div>
        <p class="hint"><Icon name="battery" size={18} /> {t.included}</p>
      </fieldset>

      <fieldset>
        <legend>{t.gearTitle}</legend>
        <p class="hint intro">{t.gearLead}</p>
        {gear.map((g) => (
          <label class={`row ${g.perWeek === null ? 'off' : ''}`}>
            <input type="checkbox" name="gear" value={g.id} disabled={g.perWeek === null} data-label={gearText[g.id][0]} />
            <span class="row-ic"><Icon name={g.icon} size={28} /></span>
            <span class="row-tx"><b>{gearText[g.id][0]}</b><small>{gearText[g.id][1]}</small></span>
            <span class="row-pr">
              {g.perWeek === null ? t.priceTbc : fill(t.plusWeek, gel(g.perWeek))}
              {g.perWeek !== null && <small>{g.season ? t.yoursSeason : fill(t.yoursAfter, g.weeks ?? 0)}</small>}
            </span>
          </label>
        ))}
      </fieldset>

      <fieldset>
        <legend>{t.servicesTitle}</legend>
        {services.map((s) => (
          <label class="row">
            <input type="checkbox" name="service" value={s.id} data-label={serviceText[s.id][0]} />
            <span class="row-ic"><Icon name={s.icon} label={s.label} size={28} /></span>
            <span class="row-tx"><b>{serviceText[s.id][0]}</b><small>{serviceText[s.id][1]}</small></span>
            <span class="row-pr">{s.perWeek ? fill(t.plusWeek, gel(s.perWeek)) : fill(t.once, gel(s.once ?? 0))}</span>
          </label>
        ))}
      </fieldset>

      <fieldset>
        <legend>{t.calcTitle}</legend>
        <div class="hours">
          <label for="hours">{t.hours}</label>
          <output for="hours"><b data-out="hours">{calc.hoursDefault}</b> {t.hoursUnit}</output>
          <input type="range" id="hours" name="hours" min={calc.hoursMin} max={calc.hoursMax} step="5" value={calc.hoursDefault} />
        </div>
        <div class="pills">
          {calc.presets.map((h, i) => <button type="button" class="pill-btn" data-hours={h}>{t.presets[i]}</button>)}
        </div>
      </fieldset>
    </div>

    <aside class="sub-sum" id="summary">
      <div class="sum-card">
        <p class="eyebrow">{t.sumTitle}</p>
        <p class="big"><b data-out="weekly">{gel(initial.weekly)}</b> ₾ <span>{t.weekly}</span></p>
        <dl>
          <div><dt>{t.lineRent}</dt><dd><span data-out="rent">{gel(initial.rent)}</span> ₾</dd></div>
          <div data-line="gear" hidden><dt>{t.lineGear}</dt><dd><span data-out="gear">0</span> ₾</dd></div>
          <div data-line="care" hidden><dt>{t.lineCare}</dt><dd><span data-out="care">0</span> ₾</dd></div>
        </dl>
        <div class="today">
          <div><b>{t.today}</b><small>{t.todayHint}</small></div>
          <b class="num"><span data-out="today">{gel(initial.today)}</span> ₾</b>
        </div>
        <dl>
          <div><dt>{t.deposit}</dt><dd>{gel(DEPOSIT)} ₾</dd></div>
          <div data-line="once" hidden><dt>{t.lineOnce}</dt><dd><span data-out="once">0</span> ₾</dd></div>
        </dl>
      </div>

      <div class="sum-card net">
        <p class="eyebrow">{t.netTitle}</p>
        <p class="big lime"><b data-out="netMonth">{gel(initial.netMonth)}</b> ₾</p>
        <dl>
          <div><dt>{t.lineIncome}</dt><dd><span data-out="incomeMonth">{gel(initial.incomeWeek * 52 / 12)}</span> ₾</dd></div>
          <div><dt>{t.lineSub}</dt><dd>−<span data-out="subMonth">{gel(initial.weekly * 52 / 12)}</span> ₾</dd></div>
          <div><dt>{t.lineEnergy}</dt><dd>−<span data-out="energyMonth">{gel(initial.energyWeek * 52 / 12)}</span> ₾</dd></div>
          <div><dt>{t.lineTax}</dt><dd>−<span data-out="taxMonth">{gel(initial.taxWeek * 52 / 12)}</span> ₾</dd></div>
        </dl>
        <p class="fine">{t.disclaimer}</p>
      </div>

      <div class="sum-card vs">
        <p class="eyebrow">{t.vsTitle}</p>
        <div class="vs-row">
          <span><Icon name="fuel" size={22} /> {t.vsPetrol}</span><b><span data-out="petrolCost">{gel(initial.petrolCostMonth)}</span> ₾</b>
          <i class="vs-bar petrol" data-bar="petrol"></i>
        </div>
        <div class="vs-row">
          <span><Icon name="bolt" size={22} /> {t.vsEv8}</span><b><span data-out="ev8Cost">{gel(initial.ev8CostMonth)}</span> ₾</b>
          <i class="vs-bar ev8" data-bar="ev8" style={`width:${Math.round((initial.ev8CostMonth / initial.petrolCostMonth) * 100)}%`}></i>
        </div>
        <p class="vs-save" data-save hidden={initial.saveMonth <= 0}>{t.vsSave} <b><span data-out="save">{gel(initial.saveMonth)}</span> ₾</b></p>
        <p class="fine">{vsNote}</p>
      </div>

      <div class="sum-card reach" id="reach">
        <p class="eyebrow">{t.contactTitle}</p>
        <label class="field">
          <span>{t.name}</span>
          <input type="text" id="q-name" name="name" required maxlength="100" autocomplete="name" aria-describedby="q-name-err" />
          <small id="q-name-err" class="field-err" hidden>{t.errName}</small>
        </label>
        <label class="field">
          <span>{t.phone}</span>
          <input type="tel" id="q-phone" name="phone" required maxlength="30" autocomplete="tel" inputmode="tel" aria-describedby="q-phone-err" />
          <small id="q-phone-err" class="field-err" hidden>{t.errPhone}</small>
        </label>
        <!-- against bots: people never see or fill this field -->
        <div class="trap" aria-hidden="true">
          <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </div>
      </div>

      <button type="submit" class="btn btn-lime btn-block" data-sub-send data-t-sending={t.sending}>{t.cta}</button>
      <p class="fine center" data-sub-note>{t.ctaNote}</p>
      <div class="sub-status" data-sub-status role="status" aria-live="polite" hidden
           data-t-sent={t.sent} data-t-sent-text={t.sentText} data-t-err={t.errOther} data-t-wa={t.errWa}></div>
    </aside>
  </form>

  <div class="sub-bar init">
    <div><b><span data-out="weekly">{gel(initial.weekly)}</span> ₾</b> <span>{t.weekly}</span><small>{t.today}: <span data-out="today">{gel(initial.today)}</span> ₾</small></div>
    <a class="btn btn-lime" href="#reach">{t.bar}</a>
  </div>
  <script is:inline set:html={client}></script>
</Base>
