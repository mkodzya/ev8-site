---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import { dict, href, localePaths, type Locale } from '../../../i18n';

export const getStaticPaths = localePaths;
const { locale } = Astro.props as { locale: Locale };
const d = dict(locale);
const t = d.how;
const icons = ['id', 'coin', 'bank', 'battery', 'wrench', 'helmet', 'swap'];
---
<Base locale={locale} title={t.metaTitle} description={t.metaDesc} path="how-it-works/">
  <section class="dark page-head">
    <div class="wrap"><h1>{t.title1} <em>{t.title2}</em></h1></div>
  </section>

  <section class="wrap info">
    <ol class="info-list">
      {t.blocks.map(([title, text], i) => (
        <li>
          <span class="row-ic"><Icon name={icons[i]} label={icons[i] === 'coin' ? '₾' : undefined} size={28} /></span>
          <div><h2>{title}</h2><p>{text}</p></div>
        </li>
      ))}
    </ol>
    <aside class="info-side">
      <div class="offer">
        <h2>{t.ctaTitle}</h2>
        <p>{t.ctaText}</p>
        <a class="btn btn-ink btn-block" href={href(locale, 'models/')}>{t.cta} →</a>
      </div>
    </aside>
  </section>
</Base>
