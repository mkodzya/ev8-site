---
import Base from '../../../layouts/Base.astro';
import { dict, href, localePaths, type Locale } from '../../../i18n';
import { faq } from '../../../lib/seo';
import { models, DEPOSIT_GEL } from '../../../data/models';

export const getStaticPaths = localePaths;
const { locale } = Astro.props as { locale: Locale };
const d = dict(locale);
const t = d.faqPage;
// The five questions of the home page first, then the rest.
// The range answer is built from the models' own figures.
const range = models.map((m) => t.rangeLine.replace('{model}', m.name).replace('{km}', String(m.rangeKm))).join(' ');
const num = (x: number) => (locale === 'en' ? String(x) : String(x).replace('.', ','));
const charge = models.map((m) => t.chargeLine.replace('{model}', m.name).replace('{h}', num(m.chargeHours))).join(' ');
const items = [...d.faq.items, ...t.more].map(([q, a]) => [q, a.replace('{range}', range).replace('{charge}', charge).replace('{deposit}', String(DEPOSIT_GEL))]);
---
<Base locale={locale} title={t.metaTitle} description={t.metaDesc} path="faq/" jsonLd={[faq(items)]}>
  <section class="dark page-head">
    <div class="wrap"><h1>{t.title1} <em>{t.title2}</em></h1></div>
  </section>

  <section class="wrap info">
    <div class="faq-list">
      {items.map(([q, a], i) => <details open={i === 0}><summary>{q}</summary><p>{a}</p></details>)}
    </div>
    <aside class="info-side">
      <div class="fuel">
        <h2 class="h2" style="margin-bottom:14px">{t.ask}</h2>
        <a class="btn btn-lime btn-block" data-ask href={href(locale, 'contacts/')}>{t.askBtn}</a>
      </div>
    </aside>
  </section>
</Base>
