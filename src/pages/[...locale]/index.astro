---
// The home page sells (Mika, 03.10.2026): a carousel of the main benefits,
// the garage, the queue for new mopeds with the way onto the waiting list
// (queue/). The papers block (licence, registration and tax) and the common
// questions are off the home page for now (Kardu, 11.10.2026); the questions
// stay on faq/. The quiz is no longer a gate: it lives in the "Write to us"
// widget (components/Ask.astro), on every page. Under the queue, the newest
// issue of the news for couriers, so the news is seen (Kardu, 05.11.2026).
import Base from '../../layouts/Base.astro';
import Promo from '../../components/Promo.astro';
import Garage from '../../components/Garage.astro';
import Reviews from '../../components/Reviews.astro';
import { dict, href, localePaths, type Locale } from '../../i18n';
import { models, fromGel } from '../../data/models';
import { latest, range, issuePath, dmy } from '../../lib/news';

export const getStaticPaths = localePaths;
const { locale } = Astro.props as { locale: Locale };
const t = dict(locale);
const queue = href(locale, 'queue/');

---
<Base locale={locale} title={t.meta.homeTitle} description={t.meta.homeDesc.replace('{n}', String(fromGel))} path="" preloadImage={models[models.length - 1].image}>
  <Promo locale={locale} />

  <section class="dark garage-screen">
    <Garage locale={locale} variant="page" id="garage" />
  </section>

  <div class="wrap reviews-row"><Reviews locale={locale} /></div>

  <section class="queue" id="queue">
    <div class="wrap">
      <div class="queue-card">
        <div>
          <p class="tag">{t.queue.tag}</p>
          <h2>{t.queue.title}</h2>
          <p class="queue-p">{t.queue.text}</p>
          <a class="btn btn-ink" href={queue}>{t.queue.cta} →</a>
        </div>
        <ol class="queue-steps">
          {t.queue.steps.map(([b, s]) => <li><div><b>{b}</b><span>{s}</span></div></li>)}
        </ol>
      </div>
    </div>
  </section>

  {latest && (
    <section class="section news-home" id="news">
      <div class="wrap">
        <h2 class="h2">{t.news.title1} <em>{t.news.title2}</em></h2>
        <p class="news-home-week"><a href={href(locale, issuePath(latest))}>{t.news.week.replace('{range}', range(latest))}</a></p>
        <ul class="news-home-list">
          {latest.items.map((it) => (
            <li>
              <a href={href(locale, issuePath(latest))}>
                <span class="news-meta">{dmy(it.date)} · {it.source}</span>
                <b>{it[locale].title}</b>
              </a>
            </li>
          ))}
        </ul>
        <a class="more" href={href(locale, 'news/')}>{t.news.all} →</a>
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap two">
      <div id="steps">
        <h2 class="h2">{t.steps.title}</h2>
        <ol class="steps">
          {t.steps.items.map(([b, s]) => <li><div><b>{b}</b><span>{s}</span></div></li>)}
        </ol>
      </div>
      <div class="col-b">
        <h2 class="h2">{t.included.title}</h2>
        <ul class="ticks">{t.included.items.map((x) => <li>{x}</li>)}</ul>
        <p class="honest">{t.included.honest}</p>
        <a class="more" href={href(locale, 'stations/')}>{t.included.stationsLink} →</a>
      </div>
    </div>
  </section>

  <section class="section about-ev8">
    <div class="wrap narrow">
      <h2 class="h2">{t.about.title}</h2>
      <p class="lede">{t.about.text.replace('{n}', String(fromGel))}</p>
    </div>
  </section>

  <section class="dark lead" id="lead">
    <div class="wrap narrow">
      <h2 class="h2">{t.closing.title1} <em>{t.closing.title2}</em></h2>
      <div class="lead-cta">
        <a class="btn btn-lime" data-ask href={href(locale, 'contacts/')}>{t.closing.ask}</a>
        <a class="btn btn-line" href={queue}>{t.closing.queue} →</a>
      </div>
    </div>
  </section>
</Base>
