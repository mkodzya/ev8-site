---
// The home page is the funnel: the quiz fills the first screen, its answer
// turns into an offer, the garage is the second screen, then how it works
// and the request.
import Base from '../../layouts/Base.astro';
import Quiz from '../../components/Quiz.astro';
import Garage from '../../components/Garage.astro';
import Lead from '../../components/Lead.astro';
import { dict, localePaths, type Locale } from '../../i18n';

export const getStaticPaths = localePaths;
const { locale } = Astro.props as { locale: Locale };
const t = dict(locale);
---
<Base locale={locale} title={t.meta.homeTitle} description={t.meta.homeDesc} path="">
  <Quiz locale={locale} />

  <section class="dark garage-screen">
    <Garage locale={locale} variant="page" id="garage" />
  </section>

  <section class="section">
    <div class="wrap two">
      <div id="steps">
        <h2 class="h2">{t.steps.title}</h2>
        <ol class="steps">
          {t.steps.items.map(([b, s]) => <li><div><b>{b}</b><span>{s}</span></div></li>)}
        </ol>
      </div>
      <div class="col-b">
        <h2 class="h2">{t.included.title}</h2>
        <ul class="ticks">{t.included.items.map((x) => <li>{x}</li>)}</ul>
        <p class="honest">{t.included.honest}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap narrow">
      <h2 class="h2">{t.faq.title}</h2>
      {t.faq.items.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
    </div>
  </section>

  <Lead locale={locale} />
</Base>
