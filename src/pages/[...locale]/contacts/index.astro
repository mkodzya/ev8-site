---
// Address, hours and phone: handbook business/places.md. Whether the showroom
// is open at the weekend is not known (register item 30), so the page says to
// call ahead rather than name hours. No embedded map: a link to directions.
import Base from '../../../layouts/Base.astro';
import { dict, localePaths, type Locale } from '../../../i18n';
import { contact } from '../../../data/models';
import { stations } from '../../../data/stations';
import Icon from '../../../components/Icon.astro';

export const getStaticPaths = localePaths;
const { locale } = Astro.props as { locale: Locale };
const d = dict(locale);
const t = d.contacts;
const maps = (q: string) => 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(q);
const route = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent('65 Shalva Nutsubidze St, Tbilisi');
---
<Base locale={locale} title={t.metaTitle} description={t.metaDesc} path="contacts/">
  <section class="dark page-head">
    <div class="wrap">
      <h1>{t.title1} <em>{t.title2}</em></h1>
      <p class="head-sub">{d.footer.address}</p>
    </div>
  </section>

  <section class="wrap info">
    <div>
      <p class="lede">{t.here}</p>
      <dl class="facts">
        <div><dt>{t.weekdays}</dt><dd>10:00–20:00</dd></div>
        <div><dt>{t.weekend}</dt><dd>{t.weekendNote}</dd></div>
        <div><dt>{t.swap}</dt><dd>{t.swapWhere}</dd></div>
        <div><dt>{t.phone}</dt><dd><a href={`tel:${contact.phone.replace(/\s/g, '')}`}>{contact.phone}</a></dd></div>
        <div><dt>{t.email}</dt><dd><a href={`mailto:${contact.email}`}>{contact.email}</a></dd></div>
      </dl>

      <h2 class="h2 stations-h">{t.stationsTitle} <small>{t.stationsNote}</small></h2>
      <ul class="stations">
        {stations.map((st, i) => (
          <li>
            <span class="row-ic"><Icon name={i === 0 ? 'bolt' : 'swap'} size={26} /></span>
            <span class="row-tx"><b>{t.stations[i][0]}</b><small>{t.stations[i][1]}</small></span>
            <a class="btn btn-line" href={maps(st.query)} rel="noopener">{t.routeShort}</a>
          </li>
        ))}
      </ul>
    </div>
    <aside class="info-side">
      <a class="btn btn-ink btn-block" href={route} rel="noopener">{t.route}</a>
      <a class="btn btn-line btn-block" data-ask href={`https://wa.me/${contact.whatsapp}`} rel="noopener">{t.wa}</a>
    </aside>
  </section>
</Base>
