---
// The request. Until the Kommo key exists (handbook register, item 5) there
// is nowhere to post a form to, so the request is a WhatsApp message the
// courier sends himself: name, chosen moped and the quiz answers, prefilled.
// The note under the button says exactly that — nothing is sent by the page.
import { dict, type Locale } from '../i18n';
import { models, contact } from '../data/models';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = dict(locale).lead;
---
<section class="dark lead" id="lead">
  <div class="wrap narrow">
    <h2 class="h2">{t.title1} <em>{t.title2}</em></h2>
    <form data-lead data-wa={contact.whatsapp} data-hello={t.msgHello} data-l-name={t.msgName} data-l-model={t.msgModel} data-l-quiz={t.msgQuiz}>
      <label class="field">{t.name}<input type="text" name="name" id="lead-name" autocomplete="given-name" maxlength="60" /></label>
      <label class="field">{t.model}
        <select name="model" id="lead-model">
          <option value="">{t.anyModel}</option>
          {models.map((m) => <option value={m.id}>{m.name} · {m.weeklyGel} ₾</option>)}
        </select>
      </label>
      <button type="submit" class="btn btn-lime btn-block">{t.send}</button>
      <p class="note">{t.note}</p>
    </form>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-lead]').forEach((form) => {
    const model = form.querySelector<HTMLSelectElement>('#lead-model')!;
    const sync = () => {
      try {
        const saved = localStorage.getItem('ev8-model');
        if (saved && Array.from(model.options).some((o) => o.value === saved)) model.value = saved;
      } catch {}
    };
    sync();
    window.addEventListener('hashchange', sync);
    window.addEventListener('pageshow', sync);
    document.addEventListener('change', (e) => { if ((e.target as HTMLElement).closest?.('[data-garage]')) sync(); });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = form.dataset;
      const name = (form.elements.namedItem('name') as HTMLInputElement).value.trim();
      const lines = [d.hello];
      if (name) lines.push(`${d.lName}: ${name}`);
      if (model.value) lines.push(`${d.lModel}: ${model.selectedOptions[0].textContent}`);
      try {
        const quiz = JSON.parse(sessionStorage.getItem('ev8-quiz') || 'null');
        if (quiz?.text) lines.push(`${d.lQuiz}: ${quiz.text}`);
      } catch {}
      window.location.href = `https://wa.me/${d.wa}?text=${encodeURIComponent(lines.join('\n'))}`;
    });
  });
</script>
