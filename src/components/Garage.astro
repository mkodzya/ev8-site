---
// The moped picker: three mopeds on a lit podium, switched by arrows, cards,
// swipe or arrow keys, looping. Works without JavaScript (radio inputs and
// labels); the script adds swipe, keys, remembering the choice and the
// entrance: the lamp comes on, the moped appears out of the dark, the figures
// follow (Mika, 03.10.2026: "as if you really walk into a garage").
import { dict, href, asset, type Locale } from '../i18n';
import { models, BATTERIES } from '../data/models';

interface Props { locale: Locale; variant?: 'page' | 'inset'; id?: string; }
const { locale, variant = 'inset', id = 'garage' } = Astro.props;
const t = dict(locale).garage;
const n = models.length;
const pad = (i: number) => String(i).padStart(2, '0');
// Under each price: the licence it needs, and for a moped that is not in the
// fleet yet, that it is insured and when it comes (Kardu, 11.10.2026; models.ts).
const notes = (m: (typeof models)[number]) =>
  [m.licence === 'none' ? t.noLicence : t.licenceAM, m.insurance ? t.insurance : null].filter(Boolean).join(' · ');
---
<div class={`garage ${variant}`} data-garage id={id}>
  {models.map((m, i) => (
    <input type="radio" name={`${id}-g`} id={`${id}-${i + 1}`} class={`g${i + 1}`} value={m.id} checked={i === 0} aria-label={m.name} />
  ))}
  {variant === 'page' && <p class="eyebrow">{t.eyebrow}</p>}
  <div class="stage">
    <div class="lamp"></div>
    <div class="beam"></div>
    {models.map((m, i) => <span class={`ghost h${i + 1}`} aria-hidden="true">{m.name}</span>)}
    <div class="ring"></div>
    {models.map((m, i) => (
      <div class={`car c${i + 1}`} role="img" aria-label={m.name} style={`background-image:url(${asset(m.image)})`}></div>
    ))}
    {models.map((_, i) => (
      <>
        <label class={`arrow prev a${i + 1}`} for={`${id}-${((i + n - 1) % n) + 1}`} aria-label={t.prev}>‹</label>
        <label class={`arrow next a${i + 1}`} for={`${id}-${((i + 1) % n) + 1}`} aria-label={t.next}>›</label>
      </>
    ))}
  </div>
  <div class="g-body">
    <div class="names">
      {models.map((m, i) => (
        <div class={`name n${i + 1}`}>
          <i>{pad(i + 1)} / {pad(n)} · {t.levels[m.level - 1]}</i>
          <b>{m.name}</b>
          <span>{m.weeklyGel} {t.perWeek}</span>
          <small class="name-note">{notes(m)}</small>
          {m.from && <small class="name-note soon">{t.soon}</small>}
        </div>
      ))}
    </div>
    <!-- Real figures only (Kardu, 11.10.2026): the bars of the owner's ranking are
         gone; more rows come as the book gets speed and the rest. -->
    <div class="stats">
      <div class="stat spec">{t.range}<em>{models.map((m, i) => <span class={`l${i + 1}`}>{t.rangeValue.replace('{km}', String(m.rangeKm)).replace('{n}', String(BATTERIES))}</span>)}</em></div>
    </div>
    <div class="thumbs">
      {models.map((m, i) => (
        <label class={`thumb t${i + 1}`} for={`${id}-${i + 1}`}>{m.name}<small>{m.weeklyGel} {t.perWeekShort}</small></label>
      ))}
    </div>
    <div class="g-cta">
      <a class="btn btn-lime btn-block" data-take href={href(locale, 'rent/')}>{t.take} →</a>
      <p class="fine">{t.included}</p>
    </div>
  </div>
</div>

<script>
  const KEY = 'ev8-model';
  document.querySelectorAll<HTMLElement>('[data-garage]').forEach((g) => {
    const radios = Array.from(g.querySelectorAll<HTMLInputElement>(':scope > input[type=radio]'));
    const stage = g.querySelector<HTMLElement>('.stage')!;
    const save = () => { try { localStorage.setItem(KEY, radios.find((r) => r.checked)!.value); } catch {} };
    const go = (step: number) => {
      const i = radios.findIndex((r) => r.checked);
      radios[(i + step + radios.length) % radios.length].checked = true;
      save();
    };
    try {
      const saved = localStorage.getItem(KEY);
      const r = radios.find((x) => x.value === saved);
      if (r) r.checked = true;
    } catch {}
    radios.forEach((r) => r.addEventListener('change', save));
    g.querySelector('[data-take]')?.addEventListener('click', save);

    let x0: number | null = null, y0 = 0;
    stage.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; }, { passive: true });
    stage.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0, dy = e.changedTouches[0].clientY - y0;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) go(dx < 0 ? 1 : -1);
      x0 = null;
    }, { passive: true });
    g.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { go(1); e.preventDefault(); }
      if (e.key === 'ArrowLeft') { go(-1); e.preventDefault(); }
    });

    // The entrance plays once, when the garage comes on screen. "js" puts the
    // stage in the dark, "in" switches the light on, "entering" keeps the slow
    // timings until everything has arrived; after that the mopeds change at
    // their usual pace.
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
      g.classList.add('js');
      const seen = new IntersectionObserver((entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        seen.disconnect();
        g.classList.add('entering');
        requestAnimationFrame(() => requestAnimationFrame(() => g.classList.add('in')));
        window.setTimeout(() => g.classList.remove('entering'), 2800);
      }, { threshold: 0.3 });
      seen.observe(g);
    }
  });
</script>
