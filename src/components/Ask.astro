---
// The panel with the three quiz questions. It opens from every "write on
// WhatsApp" link on the site (they carry data-ask) and from the request
// builder; the answers travel in the message, so the manager sees who is
// writing. On a phone the panel is a sheet from the bottom, on a laptop a card
// in the corner. The floating "Write to us" button that used to open it on
// every page is gone (Mika, 07.10.2026): the request form is the way in.
//
// The builder hands its request over with the event `ev8:request`; the answers
// are asked once per visit. If the request carries `deliver`, the finished
// message goes back to the builder, which sends it to the queue (and opens
// WhatsApp itself if that fails).
// Without JavaScript the links simply open WhatsApp.
import Icon from './Icon.astro';
import { dict, href, type Locale } from '../i18n';
import { models, contact } from '../data/models';

interface Props { locale: Locale; path: string; }
const { locale, path } = Astro.props;
const d = dict(locale);
const t = d.ask;

const questions = [
  { q: d.quiz.q1, a: d.quiz.q1a, icons: [{ name: 'bag' }, { name: 'userplus' }] },
  { q: d.quiz.q2, a: d.quiz.q2a, icons: [{ name: 'fuel' }, { name: 'car' }, { name: 'bolt' }, { name: 'walk' }] },
  { q: d.quiz.q3, a: d.quiz.q3a, icons: [{ name: 'nocard' }, { name: 'card', label: 'AM' }, { name: 'card', label: 'A·B' }] },
];
const includedIcons = ['battery', 'swap', 'wrench'];
const noviceIcons = ['id', 'bank', 'coin'];
const offers = [
  { key: 'petrol', tiles: d.info.included, icons: includedIcons },
  { key: 'car', tiles: d.info.included, icons: includedIcons },
  { key: 'electric', tiles: d.info.included, icons: includedIcons },
  { key: 'novice', tiles: d.info.novice, icons: noviceIcons },
  { key: 'other', tiles: d.info.included, icons: includedIcons },
] as const;
const names = Object.fromEntries(models.map((m) => [m.id, m.name]));
const onBuilder = path === 'subscription/';
---
<div class="ask" data-ask-root data-wa={contact.whatsapp} data-hello={t.msgHello} data-l-about={t.msgAbout} data-l-model={t.msgModel}
     data-t-wa={t.wa} data-t-send={t.send} data-models={JSON.stringify(names)}>

  <div class="ask-veil" data-ask-close hidden></div>
  <div class="ask-panel" role="dialog" aria-labelledby="ask-title" hidden>
    <div class="ask-head">
      <b id="ask-title">{t.title}</b>
      <button type="button" class="ask-x" data-ask-close aria-label={t.close}>×</button>
    </div>

    <div data-ask-box>
      <div class="qf-progress">
        <span class="qf-count">{d.quiz.step} <b data-count>1</b> {d.quiz.of} {questions.length}</span>
        <span class="dots">{questions.map((_, i) => <i class={i === 0 ? 'on' : ''}></i>)}</span>
      </div>
      {questions.map((item, i) => (
        <div data-step={i} hidden={i !== 0}>
          <h2 class="ask-q">{item.q}</h2>
          <div class="ask-opts">
            {item.a.map((a, j) => (
              <button type="button" class="ask-opt" data-answer={j}>
                <Icon name={item.icons[j].name} label={item.icons[j].label} size={30} />
                <span>{a}</span>
              </button>
            ))}
          </div>
        </div>
      ))}
    </div>

    {offers.map((o) => (
      <div class="ask-offer" data-offer={o.key} hidden>
        <h2 class="ask-q">{d.offers[o.key].title}</h2>
        <p class="ask-text">{d.offers[o.key].text}</p>
        <ul class="ask-tiles">
          {o.tiles.map((x, i) => <li><Icon name={o.icons[i]} size={24} label={o.icons[i] === 'coin' ? '₾' : undefined} /><span>{x}</span></li>)}
        </ul>
      </div>
    ))}
    <div class="ask-offer" data-ask-ready hidden>
      <h2 class="ask-q">{t.ready}</h2>
      <p class="ask-text">{t.readyText}</p>
    </div>

    <div class="ask-actions" data-ask-actions hidden>
      <a class="btn btn-lime btn-block" data-ask-send href={`https://wa.me/${contact.whatsapp}`} rel="noopener">{t.wa}</a>
      {!onBuilder && <a class="btn btn-line btn-block" data-ask-build href={href(locale, 'subscription/')}>{t.build} →</a>}
      <p class="ask-note">{t.note}</p>
      <button type="button" class="again" data-again>{d.quiz.again}</button>
    </div>
  </div>
</div>

<script>
  const KEY = 'ev8-quiz';
  const root = document.querySelector<HTMLElement>('[data-ask-root]');
  if (root) {
    const d = root.dataset;
    const panel = root.querySelector<HTMLElement>('.ask-panel')!;
    const veil = root.querySelector<HTMLElement>('.ask-veil')!;
    // What opened the panel, to give the focus back when it closes.
    let opener: HTMLElement | null = null;
    const box = root.querySelector<HTMLElement>('[data-ask-box]')!;
    const steps = Array.from(root.querySelectorAll<HTMLElement>('[data-step]'));
    const dots = Array.from(root.querySelectorAll<HTMLElement>('.dots i'));
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const offers = Array.from(root.querySelectorAll<HTMLElement>('[data-offer]'));
    const ready = root.querySelector<HTMLElement>('[data-ask-ready]')!;
    const actions = root.querySelector<HTMLElement>('[data-ask-actions]')!;
    const send = root.querySelector<HTMLAnchorElement>('[data-ask-send]')!;
    const build = root.querySelector<HTMLElement>('[data-ask-build]');
    const names = JSON.parse(d.models || '{}') as Record<string, string>;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let answers: number[] = [];
    let busy = false;
    let closing = 0;
    // Lines of a request from the subscription builder that waits for the answers.
    let request: string[] | null = null;
    type Deliver = (text: string, wa: string) => void;
    let deliver: Deliver | null = null;

    // Who is this: q1 = works as a courier (0 yes, 1 not yet), q2 = vehicle.
    const segment = (a: number[]) => (a[0] === 1 ? 'novice' : ['petrol', 'car', 'electric', 'other'][a[1]] ?? 'other');
    const labels = (a: number[]) =>
      steps.map((s, i) => s.querySelectorAll('.ask-opt span')[a[i]]?.textContent?.trim()).filter(Boolean).join(' · ');
    const stored = (): { answers?: number[]; text?: string } | null => {
      try { return JSON.parse(sessionStorage.getItem(KEY) || 'null'); } catch { return null; }
    };
    const complete = (a: unknown): a is number[] => Array.isArray(a) && a.length === steps.length;

    const message = (about: string, lines: string[] | null) => {
      const out = lines ? [...lines] : [d.hello!];
      out.push(`${d.lAbout}: ${about}`);
      if (!lines) {
        try { const m = localStorage.getItem('ev8-model'); if (m && names[m]) out.push(`${d.lModel}: ${names[m]}`); } catch {}
      }
      return out.join('\n');
    };
    const wa = (text: string) => `https://wa.me/${d.wa}?text=${encodeURIComponent(text)}`;
    const link = (about: string, lines: string[] | null) => wa(message(about, lines));

    const show = () => {
      const done = answers.length >= steps.length;
      box.hidden = done;
      steps.forEach((s, i) => (s.hidden = i !== answers.length));
      dots.forEach((dot, i) => dot.classList.toggle('on', i <= answers.length));
      count.textContent = String(Math.min(answers.length + 1, steps.length));
      const seg = done ? segment(answers) : null;
      offers.forEach((o) => (o.hidden = !!request || o.dataset.offer !== seg));
      ready.hidden = !(done && request);
      actions.hidden = !done;
      if (!done) return;
      const about = labels(answers);
      try { sessionStorage.setItem(KEY, JSON.stringify({ answers, segment: seg, text: about })); } catch {}
      send.href = link(about, request);
      send.textContent = (request ? d.tSend : d.tWa) ?? '';
      if (build) build.hidden = !!request;
    };

    // The panel changes its height smoothly when a question gives way to the next one.
    const morph = (change: () => void) => {
      if (panel.hidden || reduce || !panel.animate) { change(); return; }
      const before = panel.offsetHeight;
      change();
      const after = panel.offsetHeight;
      if (before !== after) panel.animate([{ height: `${before}px`, overflow: 'hidden' }, { height: `${after}px`, overflow: 'hidden' }], { duration: 450, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' });
    };

    const open = (lines: string[] | null = null, onDone: Deliver | null = null) => {
      window.clearTimeout(closing); closing = 0;
      panel.classList.remove('out'); veil.classList.remove('out');
      request = lines; deliver = onDone;
      const s = stored();
      answers = complete(s?.answers) ? s!.answers! : [];
      show();
      opener = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      panel.hidden = false; veil.hidden = false;
      document.documentElement.classList.add('ask-open');
      panel.querySelector<HTMLElement>('[data-step]:not([hidden]) .ask-opt, [data-ask-actions]:not([hidden]) [data-ask-send]')?.focus();
    };
    const close = () => {
      if (panel.hidden || closing) return;
      const done = () => {
        closing = 0;
        panel.classList.remove('out'); veil.classList.remove('out');
        panel.hidden = true; veil.hidden = true; request = null; deliver = null;
        document.documentElement.classList.remove('ask-open');
        opener?.focus({ preventScroll: true });
      };
      if (reduce) { done(); return; }
      // the panel sinks and the veil fades before they go
      panel.classList.add('out'); veil.classList.add('out');
      closing = window.setTimeout(done, 280);
    };

    document.addEventListener('click', (e) => {
      const el = e.target as HTMLElement;
      if (el.closest('[data-ask-close]')) { close(); return; }
      if (el.closest('[data-ask]')) { e.preventDefault(); open(); return; }
      // The send link in a builder request goes to the queue too, not straight to WhatsApp.
      if (deliver && request && el.closest('[data-ask-send]')) {
        e.preventDefault();
        const out = deliver, text = message(labels(answers), request);
        close();
        out(text, wa(text));
        return;
      }
      const opt = el.closest<HTMLElement>('[data-answer]');
      if (opt && panel.contains(opt)) {
        if (busy) return;
        busy = true;
        // The chosen answer lights up for a moment, then the next question comes.
        opt.classList.add('picked');
        window.setTimeout(() => {
          busy = false;
          opt.classList.remove('picked');
          answers.push(Number(opt.dataset.answer));
          morph(show);
          // A builder request goes out with the last answer: the tap is the send.
          if (request && answers.length >= steps.length) {
            if (deliver) {
              const out = deliver, text = message(labels(answers), request);
              close();
              out(text, wa(text));
            } else window.location.href = send.href;
          }
          else panel.querySelector<HTMLElement>('[data-step]:not([hidden]) .ask-opt, [data-ask-send]')?.focus({ preventScroll: true });
        }, reduce ? 0 : 280);
        return;
      }
      if (el.closest('[data-again]')) {
        morph(() => {
          answers = [];
          try { sessionStorage.removeItem(KEY); } catch {}
          show();
        });
      }
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });

    // The subscription builder sends its request through here, so every
    // request carries the three answers. Asked once per visit.
    document.addEventListener('ev8:request', (e) => {
      const { lines, deliver: onDone } = (e as CustomEvent<{ lines: string[]; deliver?: Deliver }>).detail;
      const s = stored();
      if (complete(s?.answers) && s?.text) {
        const text = message(s.text, lines);
        if (onDone) onDone(text, wa(text));
        else window.location.href = wa(text);
      } else open(lines, onDone ?? null);
    });
  }
</script>
