---
// The "Ask us" panel (Kardu, 11.10.2026: no WhatsApp anywhere on the site;
// a question goes by email like the waiting list does). It opens from every
// "Ask a question" button (they carry data-ask): three quick questions about
// the visitor, a short answer for who they are, then name, phone and the
// question. It posts to the same POST /api/site/queue as the waiting list —
// EV8 Ops mails it to the company and stores nothing. A mail that does not go
// out keeps what was typed and shows the phone number instead.
// On a phone the panel is a sheet from the bottom, on a laptop a card in the
// corner. Without JavaScript the buttons lead to the contacts page.
// A link ending in #ask (https://ev8.ge/#ask) opens the panel on arrival.
import Icon from './Icon.astro';
import { dict, href, type Locale } from '../i18n';
import { models, contact } from '../data/models';

interface Props { locale: Locale; path: string; }
const { locale } = Astro.props;
const d = dict(locale);
const t = d.ask;
const w = d.waitlist;

const questions = [
  { q: d.quiz.q1, a: d.quiz.q1a, icons: [{ name: 'bag' }, { name: 'userplus' }] },
  { q: d.quiz.q2, a: d.quiz.q2a, icons: [{ name: 'fuel' }, { name: 'car' }, { name: 'bolt' }, { name: 'walk' }] },
  { q: d.quiz.q3, a: d.quiz.q3a, icons: [{ name: 'nocard' }, { name: 'card', label: 'AM' }, { name: 'card', label: 'A·B' }] },
];
const includedIcons = ['battery', 'swap', 'wrench'];
const noviceIcons = ['id', 'bank', 'coin'];
const offers = [
  { key: 'petrol', tiles: d.info.included, icons: includedIcons },
  { key: 'car', tiles: d.info.included, icons: includedIcons },
  { key: 'electric', tiles: d.info.included, icons: includedIcons },
  { key: 'novice', tiles: d.info.novice, icons: noviceIcons },
  { key: 'other', tiles: d.info.included, icons: includedIcons },
] as const;
const names = Object.fromEntries(models.map((m) => [m.id, m.name]));
const tel = `tel:${contact.phone.replace(/\s/g, '')}`;
---
<div class="ask" data-ask-root data-lang={locale} data-hello={t.msgHello} data-l-about={t.msgAbout} data-l-model={t.msgModel}
     data-l-question={t.msgQuestion} data-models={JSON.stringify(names)}>

  <div class="ask-veil" data-ask-close hidden></div>
  <div class="ask-panel" role="dialog" aria-labelledby="ask-title" hidden>
    <div class="ask-head">
      <b id="ask-title">{t.title}</b>
      <button type="button" class="ask-x" data-ask-close aria-label={t.close}>×</button>
    </div>

    <div data-ask-box>
      <div class="qf-progress">
        <span class="qf-count">{d.quiz.step} <b data-count>1</b> {d.quiz.of} {questions.length}</span>
        <span class="dots">{questions.map((_, i) => <i class={i === 0 ? 'on' : ''}></i>)}</span>
      </div>
      {questions.map((item, i) => (
        <div data-step={i} hidden={i !== 0}>
          <h2 class="ask-q">{item.q}</h2>
          <div class="ask-opts">
            {item.a.map((a, j) => (
              <button type="button" class="ask-opt" data-answer={j}>
                <Icon name={item.icons[j].name} label={item.icons[j].label} size={30} />
                <span>{a}</span>
              </button>
            ))}
          </div>
        </div>
      ))}
    </div>

    {offers.map((o) => (
      <div class="ask-offer" data-offer={o.key} hidden>
        <h2 class="ask-q">{d.offers[o.key].title}</h2>
        <p class="ask-text">{d.offers[o.key].text}</p>
        <ul class="ask-tiles">
          {o.tiles.map((x, i) => <li><Icon name={o.icons[i]} size={24} label={o.icons[i] === 'coin' ? '₾' : undefined} /><span>{x}</span></li>)}
        </ul>
      </div>
    ))}

    <form class="ask-form" data-ask-form novalidate hidden>
      <h3 class="ask-form-title">{t.formTitle}</h3>
      <label class="field">
        <span>{w.name}</span>
        <input type="text" id="ask-name" name="name" required maxlength="60" autocomplete="name" aria-describedby="ask-name-err" />
        <small id="ask-name-err" class="field-err" hidden>{w.errName}</small>
      </label>
      <label class="field">
        <span>{w.phone}</span>
        <input type="tel" id="ask-phone" name="phone" required maxlength="30" autocomplete="tel" inputmode="tel" aria-describedby="ask-phone-err" />
        <small id="ask-phone-err" class="field-err" hidden>{w.errPhone}</small>
      </label>
      <label class="field">
        <span>{t.question} <small class="hint">· {t.questionHint}</small></span>
        <textarea id="ask-question" name="question" rows="3" maxlength="1200"></textarea>
      </label>
      <label class="wl-consent">
        <input type="checkbox" id="ask-consent" name="consent" required aria-describedby="ask-consent-err" />
        <span>{w.consent} <a href={href(locale, 'privacy/')}>{w.consentLink}</a>{w.consentAfter === '.' ? '.' : ` ${w.consentAfter}`}</span>
      </label>
      <small id="ask-consent-err" class="field-err" hidden>{w.errConsent}</small>
      <div class="trap" aria-hidden="true">
        <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
      </div>
      <button type="submit" class="btn btn-lime btn-block" data-ask-send data-t-sending={t.sending}>{t.send}</button>
      <div class="sub-status" data-ask-status role="status" aria-live="polite" hidden
           data-t-sent={t.sent} data-t-sent-text={t.sentText} data-t-fail={t.errFail} data-phone={contact.phone} data-tel={tel}></div>
      <a class="btn btn-line btn-block" href={href(locale, 'queue/')}>{t.queue} →</a>
      <button type="button" class="again" data-again>{d.quiz.again}</button>
    </form>
  </div>
</div>

<script>
  const KEY = 'ev8-quiz';
  const root = document.querySelector<HTMLElement>('[data-ask-root]');
  if (root) {
    const d = root.dataset;
    const panel = root.querySelector<HTMLElement>('.ask-panel')!;
    const veil = root.querySelector<HTMLElement>('.ask-veil')!;
    // What opened the panel, to give the focus back when it closes.
    let opener: HTMLElement | null = null;
    const box = root.querySelector<HTMLElement>('[data-ask-box]')!;
    const steps = Array.from(root.querySelectorAll<HTMLElement>('[data-step]'));
    const dots = Array.from(root.querySelectorAll<HTMLElement>('.dots i'));
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const offers = Array.from(root.querySelectorAll<HTMLElement>('[data-offer]'));
    const form = root.querySelector<HTMLFormElement>('[data-ask-form]')!;
    const nameIn = form.querySelector<HTMLInputElement>('#ask-name')!;
    const phoneIn = form.querySelector<HTMLInputElement>('#ask-phone')!;
    const question = form.querySelector<HTMLTextAreaElement>('#ask-question')!;
    const consent = form.querySelector<HTMLInputElement>('#ask-consent')!;
    const trap = form.querySelector<HTMLInputElement>('input[name="website"]')!;
    const send = form.querySelector<HTMLButtonElement>('[data-ask-send]')!;
    const status = form.querySelector<HTMLElement>('[data-ask-status]')!;
    const sendText = send.textContent ?? '';
    const names = JSON.parse(d.models || '{}') as Record<string, string>;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let answers: number[] = [];
    let busy = false;
    let closing = 0;

    // Who is this: q1 = works as a courier (0 yes, 1 not yet), q2 = vehicle.
    const segment = (a: number[]) => (a[0] === 1 ? 'novice' : ['petrol', 'car', 'electric', 'other'][a[1]] ?? 'other');
    const labels = (a: number[]) =>
      steps.map((s, i) => s.querySelectorAll('.ask-opt span')[a[i]]?.textContent?.trim()).filter(Boolean).join(' · ');
    const stored = (): { answers?: number[] } | null => {
      try { return JSON.parse(sessionStorage.getItem(KEY) || 'null'); } catch { return null; }
    };
    const complete = (a: unknown): a is number[] => Array.isArray(a) && a.length === steps.length;

    const message = () => {
      const out = [d.hello!, `${d.lAbout}: ${labels(answers)}`];
      try { const m = localStorage.getItem('ev8-model'); if (m && names[m]) out.push(`${d.lModel}: ${names[m]}`); } catch {}
      const q = question.value.trim();
      if (q) out.push(`${d.lQuestion}: ${q}`);
      return out.join('\n');
    };

    const show = () => {
      const done = answers.length >= steps.length;
      box.hidden = done;
      steps.forEach((s, i) => (s.hidden = i !== answers.length));
      dots.forEach((dot, i) => dot.classList.toggle('on', i <= answers.length));
      count.textContent = String(Math.min(answers.length + 1, steps.length));
      const seg = done ? segment(answers) : null;
      offers.forEach((o) => (o.hidden = o.dataset.offer !== seg));
      form.hidden = !done;
      if (done) try { sessionStorage.setItem(KEY, JSON.stringify({ answers, segment: seg })); } catch {}
    };

    // The panel changes its height smoothly when a question gives way to the next one.
    const morph = (change: () => void) => {
      if (panel.hidden || reduce || !panel.animate) { change(); return; }
      const before = panel.offsetHeight;
      change();
      const after = panel.offsetHeight;
      if (before !== after) panel.animate([{ height: `${before}px`, overflow: 'hidden' }, { height: `${after}px`, overflow: 'hidden' }], { duration: 450, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' });
    };

    const open = () => {
      window.clearTimeout(closing); closing = 0;
      panel.classList.remove('out'); veil.classList.remove('out');
      const s = stored();
      answers = complete(s?.answers) ? s!.answers! : [];
      show();
      opener = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      panel.hidden = false; veil.hidden = false;
      document.documentElement.classList.add('ask-open');
      panel.querySelector<HTMLElement>('[data-step]:not([hidden]) .ask-opt, form:not([hidden]) #ask-name')?.focus();
    };
    const close = () => {
      if (panel.hidden || closing) return;
      const done = () => {
        closing = 0;
        panel.classList.remove('out'); veil.classList.remove('out');
        panel.hidden = true; veil.hidden = true;
        document.documentElement.classList.remove('ask-open');
        opener?.focus({ preventScroll: true });
      };
      if (reduce) { done(); return; }
      // the panel sinks and the veil fades before they go
      panel.classList.add('out'); veil.classList.add('out');
      closing = window.setTimeout(done, 280);
    };

    document.addEventListener('click', (e) => {
      const el = e.target as HTMLElement;
      if (el.closest('[data-ask-close]')) { close(); return; }
      if (el.closest('[data-ask]')) { e.preventDefault(); open(); return; }
      const opt = el.closest<HTMLElement>('[data-answer]');
      if (opt && panel.contains(opt)) {
        if (busy) return;
        busy = true;
        // The chosen answer lights up for a moment, then the next question comes.
        opt.classList.add('picked');
        window.setTimeout(() => {
          busy = false;
          opt.classList.remove('picked');
          answers.push(Number(opt.dataset.answer));
          morph(show);
          panel.querySelector<HTMLElement>('[data-step]:not([hidden]) .ask-opt, form:not([hidden]) #ask-name')?.focus({ preventScroll: true });
        }, reduce ? 0 : 280);
        return;
      }
      if (el.closest('[data-again]')) {
        morph(() => {
          answers = [];
          try { sessionStorage.removeItem(KEY); } catch {}
          show();
        });
      }
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });

    // A link straight to the panel (Kardu, 11.10.2026): https://ev8.ge/#ask, for the
    // Google card's posts, Instagram, Facebook and ads. Any page with #ask opens it.
    const fromLink = () => { if (location.hash === '#ask') open(); };
    fromLink();
    window.addEventListener('hashchange', fromLink);

    // The form: checked here first, then mailed through the queue's address.
    const fieldErr = (input: HTMLInputElement, on: boolean) => {
      input.toggleAttribute('aria-invalid', on);
      const err = document.getElementById(`${input.id}-err`);
      if (err) err.hidden = !on;
    };
    [nameIn, phoneIn].forEach((i) => i.addEventListener('input', () => fieldErr(i, false)));
    consent.addEventListener('change', () => fieldErr(consent, false));

    const say = (title: string, text?: string, call = false) => {
      const b = document.createElement('b');
      b.textContent = title;
      status.replaceChildren(b);
      if (text) status.append(' ', text);
      if (call) {
        const a = document.createElement('a');
        a.href = status.dataset.tel ?? ''; a.textContent = status.dataset.phone ?? '';
        status.append(' ', a);
      }
      status.hidden = false;
      status.scrollIntoView({ block: 'nearest', behavior: reduce ? 'auto' : 'smooth' });
    };
    const busySend = (on: boolean) => { send.disabled = on; send.textContent = on ? send.dataset.tSending ?? '' : sendText; };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (send.disabled) return;
      status.hidden = true;
      const bad: HTMLInputElement[] = [];
      if (nameIn.value.trim().length < 1) bad.push(nameIn);
      if (phoneIn.value.replace(/\D/g, '').length < 9) bad.push(phoneIn);
      if (!consent.checked) bad.push(consent);
      bad.forEach((i) => fieldErr(i, true));
      if (bad.length) { bad[0].focus(); return; }

      busySend(true);
      const ctl = new AbortController();
      const timer = window.setTimeout(() => ctl.abort(), 15000);
      let res: Response;
      try {
        res = await fetch('/api/site/queue', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name: nameIn.value.trim(), phone: phoneIn.value.trim(), text: message(), lang: d.lang, page: location.pathname, website: trap.value }),
          signal: ctl.signal,
        });
      } catch {
        res = new Response(null, { status: 599 }); // network error or timeout
      } finally {
        window.clearTimeout(timer);
      }
      busySend(false);
      if (res.status === 202) {
        form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLButtonElement>('input, textarea, button[type=submit]').forEach((el) => (el.disabled = true));
        // The panel closes and the success shows as a window (Kardu, 12.10.2026).
        close();
        document.dispatchEvent(new CustomEvent('ev8:done', { detail: { title: status.dataset.tSent ?? '', text: status.dataset.tSentText } }));
        return;
      }
      if (res.status === 400) {
        const body = (await res.json().catch(() => ({}))) as { field?: string };
        const input = body.field === 'name' ? nameIn : body.field === 'phone' ? phoneIn : null;
        if (input) { fieldErr(input, true); input.focus(); return; }
      }
      // Mail off, down, unreachable or anything unexpected: what was typed
      // stays, and the visitor gets the number to call.
      say(status.dataset.tFail ?? '', undefined, true);
    });
  }
</script>
