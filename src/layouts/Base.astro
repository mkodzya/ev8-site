---
import '@fontsource/be-vietnam-pro/400.css';
import '@fontsource/be-vietnam-pro/500.css';
import '@fontsource/noto-sans-georgian/400.css';
import '@fontsource/noto-sans-georgian/500.css';
import '../styles/global.css';
import { dict, href, asset, locales, type Locale } from '../i18n';
import { contact } from '../data/models';
import Ask from '../components/Ask.astro';
import Done from '../components/Done.astro';
import { prodUrl, business, ogLocale, ogAlternates, ORIGIN } from '../lib/seo';
import latin400 from '@fontsource/be-vietnam-pro/files/be-vietnam-pro-latin-400-normal.woff2?url';
import latin500 from '@fontsource/be-vietnam-pro/files/be-vietnam-pro-latin-500-normal.woff2?url';
import georgian400 from '@fontsource/noto-sans-georgian/files/noto-sans-georgian-georgian-400-normal.woff2?url';
import georgian500 from '@fontsource/noto-sans-georgian/files/noto-sans-georgian-georgian-500-normal.woff2?url';
import logoOnLight from '../../public/img/brand/logo.svg?raw';
import logoOnDark from '../../public/img/brand/logo-light.svg?raw';

interface Props { locale: Locale; title: string; description: string; path: string; preloadImage?: string; jsonLd?: object[]; noindex?: boolean; }
const { locale, title, description, path, preloadImage, jsonLd = [], noindex: hidePage = false } = Astro.props;
// Search: one address per page, the other language beside it, and the business
// described on every page (src/lib/seo.ts).
const canonical = prodUrl(locale, path);
const structured = [business(locale), ...jsonLd];
const t = dict(locale);
// Previews are never indexed; the production build drops this flag.
const noindex = process.env.PREVIEW === '1' || hidePage;
// The site is light (Mika, 03.10.2026, after a trial next to the black one).
// THEME=dark still builds the black version; the styles are at the end of global.css.
const light = process.env.THEME !== 'dark';
// The garage page is dark whatever the theme: you walk into a garage (Mika, 03.10.2026).
const garagePage = path === 'models/';
const lightTop = light && !garagePage;
// The fonts every page draws its text with are fetched with the page itself.
// Without this Safari drew the page in a fallback font first and redrew it a
// moment later: the menu jumped sideways on every page change (measured
// 03.10.2026 — 60 px in English, 100 px in Georgian). The logo is inlined for
// the same reason: nothing in the header arrives after the first paint.
const preloadFonts = [latin500, latin400, ...(locale === 'ka' ? [georgian500, georgian400] : [])];
const warmFonts = locale === 'ka' ? [] : [georgian500, georgian400];
const cur = (p: string) => (path === p ? 'page' : undefined);
const menu: [string, string][] = [
  ['models/', t.nav.garage], ['rent/', t.sub.nav], ['stations/', t.stationsPage.nav], ['am-licence/', t.licence.nav],
  ['how-it-works/', t.how.nav], ['faq/', t.faqPage.nav], ['contacts/', t.contacts.nav],
];
---
<!doctype html>
<html lang={t.htmlLang} data-theme={light ? 'light' : undefined} data-page={garagePage ? 'garage' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {preloadFonts.map((f) => <link rel="preload" as="font" type="font/woff2" href={f} crossorigin />)}
    {preloadImage && <link rel="preload" as="image" href={asset(preloadImage)} fetchpriority="high" />}
    <link rel="icon" href={asset('favicon.ico')} sizes="32x32" />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />
    <meta name="theme-color" content={lightTop ? '#fbfbfb' : '#0b0b0b'} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content={lightTop ? 'default' : 'black-translucent'} />
    <meta name="apple-mobile-web-app-title" content="EV8" />
    <link rel="canonical" href={canonical} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={prodUrl(l, path)} />)}
    <link rel="alternate" hreflang="x-default" href={prodUrl('ka', path)} />
    <meta property="og:site_name" content="EV8" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${ORIGIN}/img/og.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale(locale)} />
    {ogAlternates(locale).map((l) => <meta property="og:locale:alternate" content={l} />)}
    <meta name="twitter:card" content="summary_large_image" />
    {structured.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body data-warm-fonts={JSON.stringify(warmFonts)}>
    <header class="top" data-tone={lightTop ? 'light' : 'dark'}>
      <div class="wrap">
        <a class="logo" href={href(locale)} aria-label={t.nav.home}><Fragment set:html={lightTop ? logoOnLight : logoOnDark} /></a>
        <nav>
          <a href={href(locale, 'models/')} aria-current={cur('models/')}>{t.nav.garage}</a>
          <a href={href(locale, 'rent/')} aria-current={cur('rent/')}>{t.sub.nav}</a>
          <a class="wide" href={href(locale, 'stations/')} aria-current={cur('stations/')}>{t.stationsPage.nav}</a>
          <a class="wide" href={href(locale, 'am-licence/')} aria-current={cur('am-licence/')}>{t.licence.nav}</a>
          <a class="wide" href={href(locale, 'how-it-works/')} aria-current={cur('how-it-works/')}>{t.how.nav}</a>
          <a class="wider" href={href(locale, 'faq/')} aria-current={cur('faq/')}>{t.faqPage.nav}</a>
          <a class="wider" href={href(locale, 'contacts/')} aria-current={cur('contacts/')}>{t.contacts.nav}</a>
          <span class="langs">
            {locales.map((l) => <a href={href(l, path)} aria-current={l === locale ? 'true' : undefined} lang={dict(l).htmlLang}>{dict(l).langName}</a>)}
          </span>
          <button type="button" class="burger" aria-expanded="false" aria-controls="menu" aria-label={t.nav.menu} data-menu-open><i></i><i></i><i></i></button>
        </nav>
      </div>
    </header>
    <!-- The menu on a phone (Kardu, 12.10.2026): every page in reach of a thumb.
         A dark curtain comes down from the top; on a wide screen the header
         shows the pages itself and the button is not there. Without
         JavaScript the footer still lists every page. -->
    <div class="menu dark" id="menu" role="dialog" aria-modal="true" aria-label={t.nav.menu} data-menu inert>
      <div class="wrap menu-top">
        <a class="logo" href={href(locale)} aria-label={t.nav.home}><Fragment set:html={logoOnDark} /></a>
        <span class="langs">
          {locales.map((l) => <a href={href(l, path)} aria-current={l === locale ? 'true' : undefined} lang={dict(l).htmlLang}>{dict(l).langName}</a>)}
        </span>
        <button type="button" class="menu-close" aria-label={t.nav.close} data-menu-close>×</button>
      </div>
      <nav class="wrap menu-list">
        {menu.map(([p, label]) => <a href={href(locale, p)} aria-current={cur(p)}>{label}<span aria-hidden="true">→</span></a>)}
      </nav>
      <div class="wrap menu-foot">
        <a class="btn btn-lime btn-block" href={href(locale, 'queue/')}>{t.promo.cta} →</a>
        <a class="menu-call" href={`tel:${contact.phone.replace(/\s/g, '')}`}>{t.nav.call}: {contact.phone}</a>
      </div>
    </div>
    <main>
      <slot />
    </main>
    <footer class="dark">
      <nav class="wrap foot-nav">
        <a href={href(locale, 'models/')}>{t.nav.garage}</a>
        <a href={href(locale, 'rent/')}>{t.sub.nav}</a>
        <a href={href(locale, 'stations/')}>{t.stationsPage.nav}</a>
        <a href={href(locale, 'am-licence/')}>{t.licence.nav}</a>
        <a href={href(locale, 'how-it-works/')}>{t.how.nav}</a>
        <a href={href(locale, 'faq/')}>{t.faqPage.nav}</a>
        <a href={href(locale, 'contacts/')}>{t.contacts.nav}</a>
        <a href={href(locale, 'queue/')}>{t.waitlist.nav}</a>
        <a href={href(locale, 'privacy/')}>{t.privacy.nav}</a>
      </nav>
      <div class="wrap foot">
        <span>{t.footer.address}</span>
        <span>{t.footer.hours}</span>
        <a href={`tel:${contact.phone.replace(/\s/g, '')}`}>{contact.phone}</a>
        <a href={`mailto:${contact.email}`}>{contact.email}</a>
        <a href={contact.instagram} rel="noopener">Instagram</a>
        <a href={contact.facebook} rel="noopener">Facebook</a>
      </div>
    </footer>
    <Ask locale={locale} path={path} />
    <Done locale={locale} />
    <script>
      // Page transitions hold the logo, the menu and the language switch in
      // place (view-transition-name in the styles, block "motion"). Two cases
      // where holding would look wrong:
      // — the visitor leaves from further down the page (a button in the middle,
      //   a footer link): the old header is off screen and would fly in from
      //   above, so it is left out and the new one fades in where it stands;
      // — the language changes: the two menus have different words in different
      //   places and would show through each other, so the old menu leaves with
      //   its page and the new one fades in. The logo and the switch stay put.
      const header = document.querySelector<HTMLElement>('.top');
      if (header) {
        const parts = Array.from(header.querySelectorAll<HTMLElement>('.logo, nav, .langs'));
        const drop = (els: HTMLElement[]) => els.forEach((el) => (el.style.viewTransitionName = 'none'));
        window.addEventListener('pageswap', () => { if (window.scrollY > header.offsetHeight) drop(parts); });
        header.querySelectorAll('.langs a').forEach((a) => a.addEventListener('click', () => drop(parts.filter((el) => el.matches('nav')))));
        window.addEventListener('pageshow', () => parts.forEach((el) => (el.style.viewTransitionName = '')));
      }
      // The phone menu: opens and closes, holds the page still while it is open,
      // and closes on Escape, on a link, and when the page comes back from history.
      const menuEl = document.querySelector<HTMLElement>('[data-menu]');
      const opener = document.querySelector<HTMLButtonElement>('[data-menu-open]');
      if (menuEl && opener) {
        const setOpen = (open: boolean) => {
          menuEl.classList.toggle('open', open);
          menuEl.inert = !open;
          opener.setAttribute('aria-expanded', String(open));
          document.documentElement.classList.toggle('menu-on', open);
          (open ? menuEl.querySelector<HTMLElement>('[data-menu-close]') : opener)?.focus({ preventScroll: true });
        };
        opener.addEventListener('click', () => setOpen(true));
        menuEl.querySelector('[data-menu-close]')?.addEventListener('click', () => setOpen(false));
        // A link to the page already on screen only closes the menu.
        menuEl.querySelectorAll<HTMLAnchorElement>('a').forEach((a) => a.addEventListener('click', (e) => {
          if (a.getAttribute('aria-current') === 'page') { e.preventDefault(); setOpen(false); }
        }));
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && menuEl.classList.contains('open')) setOpen(false); });
        window.addEventListener('pageshow', () => { if (menuEl.classList.contains('open')) setOpen(false); });
      }
      // The fonts of the other language are fetched as soon as the page has
      // loaded, so the first switch of the language does not redraw the text.
      const warm = () => (JSON.parse(document.body.dataset.warmFonts || '[]') as string[]).forEach((href) => {
        const link = document.createElement('link');
        link.rel = 'preload'; link.as = 'font'; link.type = 'font/woff2'; link.crossOrigin = ''; link.href = href;
        document.head.append(link);
      });
      if (document.readyState === 'complete') warm();
      else window.addEventListener('load', warm);
    </script>
  </body>
</html>
